-      if (has_clear_state) {
+      if (has_clear_state && !emulate_clear_state) {
          ac_pm4_cmd_add(pm4, PKT3(PKT3_CLEAR_STATE, 0, 0));
          ac_pm4_cmd_add(pm4, 0);
       }
