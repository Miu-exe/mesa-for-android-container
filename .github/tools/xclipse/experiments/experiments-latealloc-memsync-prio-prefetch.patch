diff --git a/src/amd/common/ac_shader_util.c b/src/amd/common/ac_shader_util.c
index 27ed8721c24..421b3a5a0d0 100644
--- a/src/amd/common/ac_shader_util.c
+++ b/src/amd/common/ac_shader_util.c
@@ -798,6 +798,12 @@ void ac_compute_late_alloc(const struct radeon_info *info, bool ngg, bool ngg_cu
    if (info->min_good_cu_per_sa <= 2)
       return;
 
+   /* Xclipse randomly hangs with late alloc (and the CU mask and parameter cache oversubscription
+    * that come with it). Samsung's driver never enables it either.
+    */
+   if (info->is_xclipse)
+      return;
+
    /* If scratch is used with late alloc, the GPU could deadlock if PS uses scratch too. A more
     * complicated computation is needed to enable late alloc with scratch (see PAL).
     */
diff --git a/src/amd/vulkan/radv_cp_dma.c b/src/amd/vulkan/radv_cp_dma.c
index 9275a90542c..37c9ea4ce46 100644
--- a/src/amd/vulkan/radv_cp_dma.c
+++ b/src/amd/vulkan/radv_cp_dma.c
@@ -157,6 +157,10 @@ radv_cs_cp_dma_prefetch(const struct radv_device *device, struct radv_cmd_stream
    enum amd_gfx_level gfx_level = pdev->info.gfx_level;
    uint32_t header = 0, command = 0;
 
+   /* Samsung's driver never prefetches into L2 with CP DMA on Xclipse. */
+   if (pdev->info.is_xclipse)
+      return;
+
    if (gfx_level >= GFX11)
       size = MIN2(size, 32768 - SI_CPDMA_ALIGNMENT);
 
diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
index fe71bd51928..a8b4698db24 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
@@ -1628,7 +1628,15 @@ radv_amdgpu_ctx_create(struct radeon_winsys *_ws, enum radeon_ctx_priority prior
    if (!ctx)
       return VK_ERROR_OUT_OF_HOST_MEMORY;
 
-   r = ac_drm_cs_ctx_create2(ws->dev, amdgpu_priority, &ctx->ctx_handle);
+   /* Samsung's driver creates its contexts with HIGH priority on Xclipse. Normal-priority contexts
+    * are spread over the GFX rings by the kernel, which randomly hangs at the first submission.
+    */
+   if (ws->info.is_xclipse && amdgpu_priority == AMDGPU_CTX_PRIORITY_NORMAL &&
+       !ac_drm_cs_ctx_create2(ws->dev, AMDGPU_CTX_PRIORITY_HIGH, &ctx->ctx_handle)) {
+      r = 0;
+      if (getenv("XCL_DEBUG")) fprintf(stderr, "XCL: ctx HIGH ok\n");
+   } else
+      r = ac_drm_cs_ctx_create2(ws->dev, amdgpu_priority, &ctx->ctx_handle);
    if (r && r == -EACCES) {
       result = VK_ERROR_NOT_PERMITTED;
       goto fail_create;
@@ -1889,6 +1897,12 @@ radv_amdgpu_cs_submit(struct radv_amdgpu_ctx *ctx, struct radv_amdgpu_cs_request
       chunk_data[i].ib_data.ip_instance = request->ip_instance;
       chunk_data[i].ib_data.ring = request->ring;
       chunk_data[i].ib_data.flags = ib->flags;
+
+      /* Samsung's driver has the kernel emit a full cache sync before the first IB of every
+       * submission on Xclipse.
+       */
+      if (i == 0 && ctx->ws->info.is_xclipse)
+         chunk_data[i].ib_data.flags |= AMDGPU_IB_FLAG_EMIT_MEM_SYNC;
    }
 
    assert(chunk_data[request->number_of_ibs - 1].ib_data.ip_type == request->ip_type);
