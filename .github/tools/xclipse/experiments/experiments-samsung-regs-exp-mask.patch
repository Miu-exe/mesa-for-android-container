diff --git a/src/amd/common/ac_gpu_info.h b/src/amd/common/ac_gpu_info.h
index 1d6fdeb1a0b..f3f827fa793 100644
--- a/src/amd/common/ac_gpu_info.h
+++ b/src/amd/common/ac_gpu_info.h
@@ -244,6 +244,7 @@ struct radeon_info {
    enum radeon_family family;
    enum amd_gfx_level gfx_level;
    bool is_xclipse; /* Samsung Xclipse (amdgpu-derived "sgpu" kernel driver) */
+   uint32_t xclipse_exp; /* XCLIPSE_EXP_*: temporary hang experiments (RADV_XCLIPSE_EXP) */
    uint32_t family_id;
    uint32_t chip_external_rev;
    uint32_t chip_rev; /* 0 = A0, 1 = A1, etc. */
@@ -579,6 +580,18 @@ uint32_t ac_gfx103_get_cu_mask_ps(const struct radeon_info *info);
  */
 #define AC_MESH_SCRATCH_ENTRY_BYTES (160 * 1024)
 
+/* Temporary: Samsung-like register settings for the Xclipse startup hang hunt, enabled with
+ * RADV_XCLIPSE_EXP=<mask>.
+ */
+#define XCLIPSE_EXP_GE_WAVE32     (1u << 0) /* NGG in wave32 (VGT_SHADER_STAGES_EN.GS_W32_EN) */
+#define XCLIPSE_EXP_NO_PC_ALLOC   (1u << 1) /* GE_PC_ALLOC = 0 */
+#define XCLIPSE_EXP_BINNER_LEGACY (1u << 2) /* PA_SC_BINNER_CNTL_0 = Samsung (DISABLE_BINNING_USE_LEGACY_SC) */
+#define XCLIPSE_EXP_NGG_SUBGRP    (1u << 3) /* GE_NGG_SUBGRP_CNTL.THDS_PER_SUBGRP = 256 */
+#define XCLIPSE_EXP_REQ_CTRL_VS   (1u << 4) /* SPI_SHADER_REQ_CTRL_VS = 7 */
+#define XCLIPSE_EXP_CB_RMI        (1u << 5) /* CB_RMI_GL2_CACHE_CONTROL = 0x800040 */
+#define XCLIPSE_EXP_NGG_GS_MODE   (1u << 6) /* VGT_GS_MODE = 0x200033 with NGG */
+#define XCLIPSE_EXP_BINNER_1_2    (1u << 7) /* PA_SC_BINNER_CNTL_1/_2 = Samsung */
+
 #ifdef __cplusplus
 }
 #endif
