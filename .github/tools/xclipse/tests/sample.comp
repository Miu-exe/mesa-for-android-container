#version 450
layout(local_size_x = 16) in;
layout(set = 0, binding = 0) uniform sampler2D tex;
layout(std430, set = 0, binding = 1) buffer B { vec4 d[]; };
void main() {
   uint i = gl_GlobalInvocationID.x;            /* 4x4 texel centers */
   vec2 uv = (vec2(i % 4u, i / 4u) + 0.5) / 4.0;
   d[i] = textureLod(tex, uv, 0.0);
}
